{
  "name": "Airtable Unit Sync",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "interval",
      "cron_expression": null,
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": 15,
      "interval_unit": "minutes",
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Syncs unit matrix data from Airtable into the Unit entity every 15 minutes",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "airtable_unit_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncAirtableUnits",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Sync units from Airtable",
            "description": "Pull Airtable rows into Unit matrix"
          }
        }
      }
    ]
  }
}